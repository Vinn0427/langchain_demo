# ---- 模型：OpenAI 或任意 OpenAI-compatible 服务 ----
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 可选：Embedding 使用另一家服务商时再填写（不填则复用上面的 KEY / BASE_URL）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# 示例：阿里云百炼（DashScope 兼容模式）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3

# ---- API 超时与重试（Chat 和 Embedding 共用；timeout 是每次尝试的上限，不是总上限）----
API_TIMEOUT=5
API_MAX_RETRIES=3

# ---- Qdrant（docker compose up -d）----
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=rag_demo_v3   # V3 用；V4 改为 QDRANT_ALIAS

# ---- Retrieval ----
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
RRF_TOP_K=10
RERANK_TOP_K=5

# ---- Reranker（本地 Cross-Encoder，首次运行自动下载约 1GB）----
RERANKER_MODEL=BAAI/bge-reranker-base
# FASTEMBED_CACHE_DIR=~/.cache/fastembed

# ---- Retrieval Gate（rerank_score ∈ [0,1]；Demo 初始值，正式系统应根据 Eval Dataset 调参）----
HIGH_CONFIDENCE_THRESHOLD=0.9
LOW_CONFIDENCE_THRESHOLD=0.15

# ---- Stop Condition ----
MAX_RETRY=1

# ==================== V4 ====================
# 分阶段 Timeout（秒，每次 attempt 的上限；初始值来自本 Provider 实测，不具备普适性）
# QUERY_UNDERSTANDING_TIMEOUT=12
# AGENT_DECISION_TIMEOUT=12
# GRADER_TIMEOUT=5
# REWRITE_TIMEOUT=5
# FINAL_ANSWER_TIMEOUT=10
# EMBEDDING_TIMEOUT=5
# TOOL_TIMEOUT=5
# LLM_MAX_ATTEMPTS=2              # 只对 timeout / 连接错误 / 429 / 5xx 重试
# REQUEST_DEADLINE=30             # 请求级 Latency Budget
# FINAL_ANSWER_RESERVE=6
# LLM_FAULT_INJECTION=            # 例：final_answer:1:stall（只用于复现 / 验证）
# Blue-Green：在线只读 alias；物理 collection 名 = COLLECTION_PREFIX_<strategy>_<fingerprint>
# QDRANT_ALIAS=rag_demo
# COLLECTION_PREFIX=rag_demo_v4
# CHUNK_STRATEGY=C                # A / B / C，由 eval/run_chunk_eval.py 的结果决定
# ROUTING_MODE=query_understanding  # 或 v3_agent
# MAX_TOOL_CALLS_PER_REQUEST=4
