# ---- 模型：OpenAI 或任意 OpenAI-compatible 服务 ----
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 可选：Embedding 使用另一家服务商时再填写（不填则复用上面的 KEY / BASE_URL）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# 示例：阿里云百炼（DashScope 兼容模式）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3

# ---- Qdrant（docker compose up -d）----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_demo_v3

# ---- Retrieval ----
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
RRF_TOP_K=10
RERANK_TOP_K=5

# ---- Reranker（本地 Cross-Encoder，首次运行自动下载约 1GB）----
RERANKER_MODEL=BAAI/bge-reranker-base
# FASTEMBED_CACHE_DIR=~/.cache/fastembed

# ---- Retrieval Gate（rerank_score ∈ [0,1]；Demo 初始值，正式系统应根据 Eval Dataset 调参）----
HIGH_CONFIDENCE_THRESHOLD=0.9
LOW_CONFIDENCE_THRESHOLD=0.15

# ---- Stop Condition ----
MAX_RETRY=1
